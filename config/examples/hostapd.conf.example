# StoryBox fallback setup hotspot template
interface=wlan1
driver=nl80211
country_code=IN
ssid=StoryBox-Setup
hw_mode=g
channel=6
wmm_enabled=1
auth_algs=1
wpa=2
wpa_key_mgmt=WPA-PSK
rsn_pairwise=CCMP
# Installer replaces this placeholder with a generated unique password.
wpa_passphrase=REPLACE_WITH_GENERATED_PASSWORD
