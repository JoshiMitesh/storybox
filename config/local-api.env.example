# Copy to /etc/storybox/local-api.env.
# Keep this file readable only by root and the admin service account.
# The API creates its own bearer token after first-time admin registration.
# Keep loopback for local-only access; use 0.0.0.0 only on a trusted setup LAN.
STORYBOX_API_HOST=127.0.0.1
STORYBOX_API_PORT=8089
STORYBOX_FIRMWARE_VERSION=0.1.0
