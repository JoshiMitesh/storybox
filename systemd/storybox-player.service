[Unit]
Description=StoryBox Offline Story Player
After=sound.target systemd-udev-settle.service
Wants=sound.target

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/home/admin
ExecStart=/usr/bin/python3 -u /opt/storybox/src/storybox/player/story_player.py
Restart=on-failure
RestartSec=3
UMask=0027

[Install]
WantedBy=multi-user.target
