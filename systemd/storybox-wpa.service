[Unit]
Description=storybox wifi connection service
Requires=sys-subsystem-net-devices-wlan1.device
After=sys-subsystem-net-devices-wlan1.device
Before=storybox-wifi.service

[Service]
Type=simple
ExecStartPre=/usr/sbin/ip link set wlan1 up
ExecStart=/usr/sbin/wpa_supplicant -i wlan1 -c /etc/storybox/wpa_supplicant.conf -D nl80211
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
