[Unit]
Description=StoryBox Automatic Wi-Fi Fallback Hotspot Manager
After=NetworkManager.service
Wants=NetworkManager.service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/usr/bin/nmcli radio wifi on
ExecStart=/usr/bin/python3 -u /opt/storybox/src/storybox/wifi/wifi_manager.py
WorkingDirectory=/opt/storybox/src/storybox/wifi
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
